<Window x:Class="MicSwitcher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicSwitcher" Height="640" Width="880"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题 + 当前状态 ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🎤 MicSwitcher" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Text="正在加载…" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== 主体：左「模式」 + 右「设备」 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：模式 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="模式" Style="{StaticResource GroupTitle}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="✋ 手动" FontSize="14"/>
                            <TextBlock Text="自己点着换" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ModeManualToggle" Style="{StaticResource ToggleSwitch}"
                                  Checked="ModeManual_Changed" Unchecked="ModeManual_Changed"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🤖 自动" FontSize="14"/>
                            <TextBlock Text="按策略自动切" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ModeAutoToggle" Style="{StaticResource ToggleSwitch}"
                                  Checked="ModeAuto_Changed" Unchecked="ModeAuto_Changed"/>
                    </Grid>

                    <Border Height="1" Background="#FFEEEEEE" Margin="0,12"/>

                    <TextBlock Text="自动策略" Style="{StaticResource GroupTitle}"/>
                    <RadioButton x:Name="StrategyByLevel" GroupName="Strategy" Margin="0,0,0,8"
                                 Checked="Strategy_Changed">
                        <TextBlock Text="🎚 按声音大小" FontSize="13"/>
                    </RadioButton>
                    <RadioButton x:Name="StrategyByNewDevice" GroupName="Strategy"
                                 Checked="Strategy_Changed">
                        <TextBlock Text="🔌 按新设备" FontSize="13"/>
                    </RadioButton>
                    <TextBlock Text="插上麦克风就自动切过去。" Style="{StaticResource Hint}" Margin="20,6,0,0"/>

                    <Border Height="1" Background="#FFEEEEEE" Margin="0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🔒 锁定当前麦" FontSize="13"/>
                            <TextBlock Text="被改动就自动改回" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="LockToggle" Style="{StaticResource ToggleSwitch}"
                                  Checked="Lock_Changed" Unchecked="Lock_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 右栏：设备卡片 -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="麦克风设备" Style="{StaticResource GroupTitle}"/>

                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="设为默认" Padding="12,6" Margin="0,0,8,0" Click="SetDefault_Click"/>
                    <Button Content="静音 / 取消静音" Padding="12,6" Margin="0,0,8,0" Click="ToggleMute_Click"/>
                    <Button Content="🔄 下一个" Padding="12,6" Click="Cycle_Click"/>
                </WrapPanel>

                <Grid>
                    <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="DeviceList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceItemStyle}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE5E5E5" BorderThickness="1" CornerRadius="8"
                                        Padding="12,10" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="[默认]" Foreground="Green" FontWeight="Bold" FontSize="12"
                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="🔇已静音" Foreground="Orange" FontSize="12"
                                                           Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▲" Style="{StaticResource IconButton}"
                                                    ToolTip="上移一位" Click="MoveUp_Click" Tag="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                    ToolTip="下移一位" Click="MoveDown_Click" Tag="{Binding}"/>
                                            <Border Margin="8,0,0,0" Background="Transparent" Cursor="SizeNS"
                                                    Tag="dragHandle"
                                                    ToolTip="按住此处拖动排序">
                                                <TextBlock Text="⠿" Foreground="Gray" FontSize="16"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 拖拽幽灵层与插入指示线都画在这里（不参与命中测试） -->
                    <Canvas x:Name="DragLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ===== 底部工具条 ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" Padding="14,6" Click="OpenPreferences_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" Margin="0,0,6,0"/>
                    <TextBlock Text="设置"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Right" Padding="14,6" Content="刷新" Click="Refresh_Click"/>
        </Grid>
    </Grid>
</Window>
